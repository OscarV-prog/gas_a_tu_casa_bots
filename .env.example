# Required: At least one LLM API key (depending on your tenant configs)
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional: LangSmith tracing (highly recommended for debugging)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=sales-agent

# Optional: Tenant directory override (defaults to ./tenants)
TENANTS_DIR=./tenants

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=your_meta_system_user_or_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
WHATSAPP_API_VERSION=v21.0

# Facebook Messenger (Meta Graph API)
MESSENGER_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
MESSENGER_VERIFY_TOKEN=petroil_gas_webhook_secret
MESSENGER_PAGE_ID=your_page_id
MESSENGER_APP_SECRET=your_app_secret
MESSENGER_API_VERSION=v21.0

# Instagram Direct Messaging (Meta Graph API)
INSTAGRAM_ACCESS_TOKEN=your_instagram_page_or_user_access_token
INSTAGRAM_VERIFY_TOKEN=petroil_gas_webhook_secret
INSTAGRAM_ACCOUNT_ID=your_instagram_professional_account_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_API_VERSION=v21.0

# === CONFIGURACIÓN DE API CENTRALIZADA (NestJS + PostgreSQL) ===
API_BASE_URL=https://api-gasera-x.loca.lt/api
TENANT_ID=petroil
DATA_SOURCE=api
