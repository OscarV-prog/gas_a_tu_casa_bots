# =================================================================
# VARIABLES DE ENTORNO - SISTEMA DE BOTS PETROIL (GAS A TU PUERTA)
# =================================================================

# 1. INTELIGENCIA ARTIFICIAL (LLM)
# Compatible con OpenRouter, OpenAI o Anthropic
OPENROUTER_API_KEY=tu_api_key_de_openrouter
LLM_MODEL=deepseek/deepseek-v4-flash-0731
# OPENAI_API_KEY=tu_openai_key
# ANTHROPIC_API_KEY=tu_anthropic_key

# 2. BOTS DE TELEGRAM
# Bot para clientes (Venta y pedidos)
TELEGRAM_BOT_TOKEN=tu_token_bot_clientes
TELEGRAM_TENANT_ID=petroil

# Bot para choferes (Despacho, rutas y coordenadas)
TELEGRAM_DRIVER_BOT_TOKEN=tu_token_bot_choferes

# 3. META MESSENGER (Facebook Graph API)
MESSENGER_PAGE_ACCESS_TOKEN=tu_token_de_pagina_facebook
MESSENGER_VERIFY_TOKEN=petroil_gas_webhook_secret
MESSENGER_PAGE_ID=tu_facebook_page_id
MESSENGER_APP_SECRET=
MESSENGER_API_VERSION=v21.0

# URL pública con HTTPS donde responde este servidor (para links de tracking)
PUBLIC_BASE_URL=https://petrogas.petroil.dev

# 4. WHATSAPP CLOUD API (Opcional si se usa WhatsApp)
WHATSAPP_TOKEN=tu_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
WHATSAPP_VERIFY_TOKEN=petroil_gas_webhook_secret
WHATSAPP_BUSINESS_ACCOUNT_ID=tu_waba_id
WHATSAPP_API_VERSION=v21.0

# 5. INSTAGRAM DIRECT (Opcional si se usa Instagram)
INSTAGRAM_ACCESS_TOKEN=tu_instagram_access_token
INSTAGRAM_VERIFY_TOKEN=petroil_gas_webhook_secret
INSTAGRAM_ACCOUNT_ID=tu_instagram_account_id
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_VERSION=v21.0

# 6. CONEXIÓN AL BACKEND / ERP (NestJS + PostgreSQL)
API_BASE_URL=https://petrogas-api.petroil.dev/api/
TENANT_ID=petroil
DATA_SOURCE=api
API_EMAIL=tu_usuario_api@petroil.dev
API_PASSWORD=tu_contrasena_api
